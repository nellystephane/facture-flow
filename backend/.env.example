# ===== FactuFlow Backend — Variables d'environnement =====
# Copiez ce fichier en .env et remplissez les valeurs

# Connexion MongoDB Atlas (ou local)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/factuflow?retryWrites=true&w=majority

# Port du serveur
PORT=5000

# Secret JWT (CHANGEZ-LE en production — chaîne aléatoire longue)
JWT_SECRET=changez_moi_pour_une_chaine_aleatoire_longue_et_secrete

# URL du frontend (CORS)
CLIENT_URL=http://localhost:5173
