# Copiez ce fichier en .env.local pour le développement,
# ou définissez cette variable dans les paramètres de votre hébergeur (Vercel, Netlify...).

# URL complète de l'API backend en production, ex :
# VITE_API_URL=https://api.factuflow.com/api
# Laissez vide en local : le proxy de vite.config.ts s'en charge.
VITE_API_URL=https://facture-flow.onrender.com