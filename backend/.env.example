# ===== Oryxa Backend — Variables d'environnement =====
# Copiez ce fichier en .env et remplissez les valeurs

# Connexion MongoDB Atlas (ou local)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/oryxa?retryWrites=true&w=majority

# Port du serveur
PORT=5000

# Secret JWT (CHANGEZ-LE en production — chaîne aléatoire longue)
JWT_SECRET=changez_moi_pour_une_chaine_aleatoire_longue_et_secrete

# URL du frontend (CORS) — l'ORIGINE uniquement (schéma + domaine), jamais
# de chemin après. Sur GitHub Pages par exemple : https://votre-user.github.io
# (PAS https://votre-user.github.io/facture-flow). Plusieurs origines
# séparées par des virgules sont acceptées (utile pour garder localhost en dev).
CLIENT_URL=http://localhost:5173

# URL publique complète du frontend (avec sous-chemin éventuel), utilisée
# dans les liens générés côté serveur (emails, PDF, retour de paiement
# FedaPay). Si absent, on utilise la première valeur de CLIENT_URL.
CLIENT_URL_PUBLIC=http://localhost:5173

# ===== Envoi d'email =====
# Option recommandée pour Oryxa : Brevo. Créez un compte sur https://www.brevo.com
# puis récupérez la clé SMTP dans Paramètres > SMTP & API > SMTP.
# Les variables SMTP_* génériques sont aussi acceptées si vous utilisez un
# autre fournisseur. Ne mettez JAMAIS le mot de passe de votre boîte email
# principale ici si votre fournisseur propose une clé SMTP dédiée.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
# Alternative SMTP générique :
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# L'adresse doit être autorisée par votre fournisseur SMTP.
EMAIL_FROM="Oryxa <contact@emgdigitalsolutions.bj>"

# ===== Paiement en ligne — FedaPay (Mobile Money MTN/Moov, carte, virement) =====
# Créez un compte sur https://fedapay.com, récupérez vos clés API (sandbox puis
# live) sur https://docs.fedapay.com. Tant que FEDAPAY_SECRET_KEY est absent,
# les fonctionnalités de paiement en ligne et d'abonnement payant renvoient une
# erreur explicite au lieu d'échouer silencieusement.
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=
# À activer uniquement après activation Payouts par FedaPay sur le compte marchand
FEDAPAY_PAYOUTS_ENABLED=false

# ===== Monitoring des erreurs — Sentry (optionnel) =====
# Créez un projet Node.js gratuit sur https://sentry.io et collez son DSN
# ci-dessous. Tant que SENTRY_DSN est absent, l'app fonctionne normalement,
# simplement sans remontée automatique des erreurs serveur vers un tableau
# de bord (voir backend/utils/monitoring.js).
SENTRY_DSN=

# Environnement (affiché dans Sentry pour distinguer prod/dev/staging)
NODE_ENV=production

# ===== Espace admin plateforme (/admin) — voir docs/ADMIN_ACCESS.md =====
# Emails autorisés à se connecter à /admin, séparés par des virgules.
ADMIN_EMAILS=
# Recommandé : hash bcrypt du mot de passe admin (générez-le avec
# `node scripts/generateAdminPasswordHash.js "VotreMotDePasse"`).
ADMIN_PASSWORD_HASH=
# Alternative rapide (moins sûre) : mot de passe en clair. Ignoré si
# ADMIN_PASSWORD_HASH est défini.
ADMIN_PASSWORD=
# Secret de signature des tokens admin — si absent, JWT_SECRET est réutilisé.
ADMIN_JWT_SECRET=

# Support client — les demandes arrivent aussi par email (facultatif si la valeur par défaut convient)
SUPPORT_EMAIL=contact@emgdigitalsolutions.bj
